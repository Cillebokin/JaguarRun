####### Build rules

first: all
all: Makefile.Release Bin\JaguarCore.prl Bin\JaguarCore.dll

Bin\JaguarCore.dll:  $(OBJECTS) .obj\JaguarCore_resource.res
	$(LINKER) $(LFLAGS) /MANIFEST:embed /OUT:$(DESTDIR_TARGET) @<<
.obj\SoaGeometryAvx2.obj .obj\Version.obj .obj\Result.obj .obj\Edge.obj .obj\Circle.obj .obj\Transformation.obj .obj\PointOfInaccessibility.obj .obj\SimplePolygon.obj .obj\ConvexHull.obj .obj\OriginalShape.obj .obj\Simplify.obj .obj\Offset.obj .obj\StraightSkeleton.obj .obj\NarrowConcavity.obj .obj\Item.obj .obj\Container.obj .obj\PlacedItem.obj .obj\Layout.obj .obj\ExternalRepr.obj .obj\Importer.obj .obj\JsonCodec.obj .obj\SvgExport.obj .obj\Strip.obj .obj\Instance.obj .obj\Problem.obj .obj\Solution.obj .obj\BppBin.obj .obj\BppInstance.obj .obj\BppProblem.obj .obj\BppSolution.obj .obj\MspStrip.obj .obj\MspInstance.obj .obj\MspProblem.obj .obj\MspSolution.obj .obj\Assertions.obj .obj\Surrogate.obj .obj\Collector.obj .obj\Quadtree.obj .obj\ThreadPool.obj .obj\SoaGeometry.obj .obj\CollisionEngine.obj
$(LIBS)
<<

.obj\JaguarCore_resource.res: JaguarCore_resource.rc
	rc /NOLOGO $(DEFINES) -fo .obj\JaguarCore_resource.res JaguarCore_resource.rc

Bin\JaguarCore.prl: 
	@$(QMAKE) -prl ..\..\JaguarCore.pro  -spec win32-msvc "CONFIG+=release"
qmake: FORCE
	@$(QMAKE) -o Makefile.Release ..\..\JaguarCore.pro -spec win32-msvc "CONFIG+=release"

