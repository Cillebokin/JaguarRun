	$(LINKER) $(LFLAGS) /MANIFEST:embed /OUT:$(DESTDIR_TARGET) @<<
.obj\soa_geometry_avx2.obj .obj\version.obj .obj\result.obj .obj\edge.obj .obj\circle.obj .obj\transformation.obj .obj\simple_polygon.obj .obj\convex_hull.obj .obj\original_shape.obj .obj\simplify.obj .obj\offset.obj .obj\straight_skeleton.obj .obj\narrow_concavity.obj .obj\item.obj .obj\container.obj .obj\placed_item.obj .obj\layout.obj .obj\external_repr.obj .obj\importer.obj .obj\json_codec.obj .obj\svg_export.obj .obj\strip.obj .obj\instance.obj .obj\problem.obj .obj\solution.obj .obj\bpp_bin.obj .obj\bpp_instance.obj .obj\bpp_problem.obj .obj\bpp_solution.obj .obj\msp_strip.obj .obj\msp_instance.obj .obj\msp_problem.obj .obj\msp_solution.obj .obj\assertions.obj .obj\surrogate.obj .obj\collector.obj .obj\quadtree.obj .obj\thread_pool.obj .obj\soa_geometry.obj .obj\collision_engine.obj
$(LIBS)
<<

.obj\JaguarCore_resource.res: JaguarCore_resource.rc
	rc /NOLOGO $(DEFINES) -fo .obj\JaguarCore_resource.res JaguarCore_resource.rc

..\.style-build-release\bin\JaguarCore.prl: 
	@$(QMAKE) -prl ..\JaguarCore\JaguarCore.pro  "CONFIG+=debug" "JAGUARCORE_PACKAGE_ROOT=D:\MyWorks\ProQt\JaguarRun\.style-build-debug\package"
qmake: FORCE
	@$(QMAKE) -o Makefile.Release ..\JaguarCore\JaguarCore.pro "CONFIG+=debug" "JAGUARCORE_PACKAGE_ROOT=D:\MyWorks\ProQt\JaguarRun\.style-build-debug\package"

qmake_all: FORCE

