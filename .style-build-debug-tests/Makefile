html_docs:
	$(MAKE) -f $(MAKEFILE) prepare_docs && $(MAKE) -f $(MAKEFILE) generate_docs

docs:
	$(MAKE) -f $(MAKEFILE) html_docs && $(MAKE) -f $(MAKEFILE) qch_docs

debug-install_html_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug install_html_docs
install_html_docs: debug-install_html_docs

debug-uninstall_html_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug uninstall_html_docs
uninstall_html_docs: debug-uninstall_html_docs

debug-install_qch_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug install_qch_docs
install_qch_docs: debug-install_qch_docs

debug-uninstall_qch_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug uninstall_qch_docs
uninstall_qch_docs: debug-uninstall_qch_docs

debug-install_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug install_docs
install_docs: debug-install_docs

debug-uninstall_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug uninstall_docs
uninstall_docs: debug-uninstall_docs

debug-qch_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug qch_docs
qch_docs: debug-qch_docs

debug-prepare_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug prepare_docs
prepare_docs: debug-prepare_docs

debug-generate_docs:
	@set MAKEFLAGS=$(MAKEFLAGS)
	$(MAKE) -f $(MAKEFILE).Debug generate_docs
generate_docs: debug-generate_docs

check: first

benchmark: first
FORCE:

$(MAKEFILE).Debug: Makefile
$(MAKEFILE).Release: Makefile
