install_jaguarcore_runtime: first FORCE
	@if not exist D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin mkdir D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin & if not exist D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin exit 1
	-$(QINSTALL) D:\MyWorks\ProQt\JaguarRun\Bin\JaguarCored.dll D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin\JaguarCored.dll

uninstall_jaguarcore_runtime: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin\JaguarCored.dll
	-$(DEL_DIR) D:$(INSTALL_ROOT)\MyWorks\package-JaguarCore-style-debug2\Debug\avx2\Bin 


